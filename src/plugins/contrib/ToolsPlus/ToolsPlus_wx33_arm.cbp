<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Tools Plus Plugin wx3.3.x (ARM, 64 bit)" />
		<Option compiler="llvm-mingw-arm64_compiler" />
		<Build>
			<Target title="default">
				<Option output="../../../devel33_arm/share/codeblocks/plugins/ToolsPlus" prefix_auto="1" extension_auto="1" />
				<Option object_output="../../../.objs33_arm/plugins/contrib/ToolsPlus" />
				<Option type="3" />
				<Option compiler="llvm-mingw-arm64_compiler" />
				<Option parameters="--debug-log --multiple-instance -na -ns -nd -p debug" />
				<Option host_application="../../../devel33_arm/codeblocks.exe" />
				<Option run_host_application_in_terminal="0" />
				<Compiler>
					<Add option="$(#CB_RELEASE_TYPE)" />
					<Add option="$(#CB_CPP_STD)" />
				</Compiler>
				<Linker>
					<Add library="codeblocks" />
					<Add library="wxmsw$(WX_VERSION)$(WX_SUFFIX)" />
					<Add library="gdi32" />
					<Add directory="../../../devel33_arm" />
					<Add directory="$(#wx33_arm.lib)/clang_x64_dll_mono" />
				</Linker>
			</Target>
			<Environment>
				<Variable name="WX_CFG" value="" />
				<Variable name="WX_SUFFIX" value="u" />
				<Variable name="WX_VERSION" value="33" />
			</Environment>
		</Build>
		<VirtualTargets>
			<Add alias="All" targets="default;" />
		</VirtualTargets>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-pipe" />
			<Add option="-fmessage-length=0" />
			<Add option="-fexceptions" />
			<Add option="$(#CB_RELEASE_TYPE)" />
			<Add option="$(#CB_CPP_STD)" />
			<Add option="-DWXUSINGDLL" />
			<Add option="-DHAVE_W32API_H" />
			<Add option="-D__WXMSW__" />
			<Add option="-D_WIN64" />
			<Add option="-DcbDEBUG" />
			<Add option="-DNOPCH" />
			<Add option="-DwxUSE_UNICODE" />
			<Add option="-DBUILDING_PLUGIN" />
			<Add directory="../../../include" />
			<Add directory="../../../include/tinyxml" />
			<Add directory="../../../sdk/wxscintilla/include" />
			<Add directory="$(#wx33_arm.include)" />
			<Add directory="$(#wx33_arm.lib)/clang_x64_dll_mono/msw$(WX_SUFFIX)" />
		</Compiler>
		<Linker>
			<Add option="-mthreads" />
		</Linker>
		<ExtraCommands>
			<Add after="zip -j9 ..\..\..\devel33_arm\share\codeblocks\ToolsPlus.zip manifest.xml" />
			<Add after="update33_arm.bat" />
			<Mode after="always" />
		</ExtraCommands>
		<Unit filename="CmdConfigDialog.cpp" />
		<Unit filename="CmdConfigDialog.h" />
		<Unit filename="PipedProcessCtrl.cpp" />
		<Unit filename="PipedProcessCtrl.h" />
		<Unit filename="Resources/dialogs.fbp" />
		<Unit filename="ShellCtrlBase.cpp" />
		<Unit filename="ShellCtrlBase.h" />
		<Unit filename="ToolsPlus.cpp" />
		<Unit filename="ToolsPlus.h" />
		<Unit filename="manifest.xml" />
		<Unit filename="se_globals.cpp" />
		<Unit filename="se_globals.h" />
		<Unit filename="shellproperties.cpp" />
		<Unit filename="shellproperties.h" />
		<Unit filename="update33" />
		<Unit filename="update33_64.bat" />
		<Extensions />
	</Project>
</CodeBlocks_project_file>
