<?xml version="1.0" encoding="utf-8" ?>
<resource xmlns="http://www.wxwidgets.org/wxxrc" version="2.5.3.0">
	<object class="wxScrollingDialog" name="MainFrame">
		<title>Dev-C++ DevPaks updater / installer</title>
		<centered>1</centered>
		<style>wxDEFAULT_DIALOG_STYLE|wxRESIZE_BORDER|wxMAXIMIZE_BOX</style>
		<object class="wxBoxSizer">
			<orient>wxVERTICAL</orient>
			<object class="sizeritem">
				<object class="wxFlexGridSizer">
					<cols>2</cols>
					<hgap>8</hgap>
					<growablecols>1</growablecols>
					<object class="sizeritem">
						<object class="wxStaticText" name="ID_STATICTEXT1">
							<label>Update server:</label>
						</object>
						<flag>wxEXPAND</flag>
					</object>
					<object class="sizeritem">
						<object class="wxStaticText" name="lblStatus">
							<label>Status</label>
						</object>
						<flag>wxEXPAND</flag>
					</object>
					<object class="sizeritem">
						<object class="wxComboBox" name="cmbServer">
							<style>wxCB_READONLY</style>
						</object>
						<flag>wxEXPAND</flag>
					</object>
					<object class="sizeritem">
						<object class="wxGauge" name="gauProgress">
							<size>-1,20</size>
						</object>
						<flag>wxEXPAND</flag>
					</object>
					<object class="sizeritem">
						<object class="wxCheckBox" name="chkCache">
							<label>Use cache</label>
							<checked>1</checked>
						</object>
						<flag>wxTOP|wxALIGN_LEFT|wxALIGN_TOP</flag>
						<border>4</border>
					</object>
					<object class="sizeritem">
						<object class="wxStaticText" name="lblProgress">
							<label></label>
						</object>
						<flag>wxEXPAND</flag>
					</object>
				</object>
				<flag>wxALL|wxEXPAND</flag>
				<border>8</border>
			</object>
			<object class="sizeritem">
				<object class="wxStaticLine" name="ID_STATICLINE1" />
				<flag>wxLEFT|wxRIGHT|wxEXPAND</flag>
				<border>8</border>
			</object>
			<object class="sizeritem">
				<object class="wxStaticBoxSizer">
					<label>Filtering</label>
					<object class="sizeritem">
						<object class="wxStaticText" name="ID_STATICTEXT2">
							<label>Global filter:</label>
						</object>
						<flag>wxTOP|wxLEFT|wxEXPAND</flag>
						<border>4</border>
					</object>
					<object class="sizeritem">
						<object class="wxComboBox" name="cmbFilter">
							<content>
								<item>All files</item>
								<item>Installed</item>
								<item>Installed with update available</item>
								<item>Downloaded but not installed</item>
								<item>Not installed</item>
							</content>
							<selection>0</selection>
							<style>wxCB_READONLY</style>
						</object>
						<flag>wxLEFT|wxRIGHT|wxEXPAND</flag>
						<border>8</border>
						<option>1</option>
					</object>
				</object>
				<flag>wxTOP|wxLEFT|wxRIGHT|wxEXPAND</flag>
				<border>8</border>
			</object>
			<object class="sizeritem">
				<object class="wxStaticBoxSizer">
					<label>DevPaks</label>
					<object class="sizeritem">
						<object class="wxBoxSizer">
							<orient>wxVERTICAL</orient>
							<object class="sizeritem">
								<object class="wxStaticText" name="ID_STATICTEXT3">
									<label>Categories:</label>
								</object>
								<flag>wxEXPAND</flag>
							</object>
							<object class="sizeritem">
								<object class="wxTreeCtrl" name="tvCategories">
									<image_list></image_list>
									<tree_items>
										<item>TreeCtrl1</item>
										<item></item>
									</tree_items>
									<items_text>
										<item2>TreeCtrl1</item2>
										<item2></item2>
									</items_text>
								</object>
								<flag>wxEXPAND</flag>
								<option>1</option>
							</object>
						</object>
						<flag>wxEXPAND</flag>
					</object>
					<object class="sizeritem">
						<object class="wxBoxSizer">
							<orient>wxVERTICAL</orient>
							<object class="sizeritem">
								<object class="wxStaticText" name="ID_STATICTEXT4">
									<label>DevPaks in category (right-click for options):</label>
								</object>
								<flag>wxEXPAND</flag>
							</object>
							<object class="sizeritem">
								<object class="wxListCtrl" name="lvFiles">
									<style>wxLC_REPORT|wxLC_SINGLE_SEL</style>
								</object>
								<flag>wxEXPAND</flag>
								<option>1</option>
							</object>
							<object class="sizeritem">
								<object class="wxStaticText" name="ID_STATICTEXT5">
									<label>Selected DevPak&apos;s details:</label>
								</object>
								<flag>wxTOP|wxEXPAND</flag>
								<border>8</border>
							</object>
							<object class="sizeritem">
								<object class="wxTextCtrl" name="txtInfo">
									<style>wxTE_MULTILINE|wxTE_READONLY</style>
								</object>
								<flag>wxEXPAND</flag>
								<option>1</option>
							</object>
						</object>
						<flag>wxLEFT|wxEXPAND</flag>
						<border>8</border>
						<option>1</option>
					</object>
				</object>
				<flag>wxALL|wxEXPAND</flag>
				<border>8</border>
				<option>1</option>
			</object>
			<object class="sizeritem">
				<object class="wxBoxSizer">
					<object class="sizeritem">
						<object class="wxButton" name="wxID_CANCEL">
							<label>&amp;Close</label>
						</object>
						<flag>wxALIGN_LEFT</flag>
					</object>
				</object>
				<flag>wxBOTTOM|wxLEFT|wxRIGHT|wxALIGN_CENTER_HORIZONTAL</flag>
				<border>8</border>
			</object>
		</object>
	</object>
</resource>
