<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="DragScroll wx3.3.x (ARM, 64 bit)" />
		<Option pch_mode="0" />
		<Option compiler="llvm-mingw-arm64_compiler" />
		<Build>
			<Target title="default">
				<Option output="../../../devel33_arm/share/CodeBlocks/plugins/DragScroll.dll" prefix_auto="0" extension_auto="0" />
				<Option object_output="../../../.objs33_arm/plugins/contrib/dragscroll" />
				<Option type="3" />
				<Option compiler="llvm-mingw-arm64_compiler" />
				<Option parameters="--debug-log --multiple-instance -na -ns -nd -p debug" />
				<Option host_application="../../../devel33_arm/codeblocks.exe" />
				<Option run_host_application_in_terminal="0" />
				<Compiler>
					<Add option="$(#CB_RELEASE_TYPE)" />
					<Add option="$(#CB_CPP_STD)" />
				</Compiler>
			</Target>
			<Environment>
				<Variable name="WX_CFG" value="" />
				<Variable name="WX_SUFFIX" value="u" />
				<Variable name="WX_VERSION" value="33" />
			</Environment>
		</Build>
		<VirtualTargets>
			<Add alias="All" targets="default;" />
		</VirtualTargets>
		<Compiler>
			<Add option="-Wall" />
			<Add option="$(#CB_RELEASE_TYPE)" />
			<Add option="-pipe" />
			<Add option="-fmessage-length=0" />
			<Add option="-fexceptions" />
			<Add option="-Wno-unused-local-typedefs" />
			<Add option="-DBUILDING_PLUGIN" />
			<Add option="-DNOPCH" />
			<Add option="-DHAVE_W32API_H" />
			<Add option="-D__WXMSW__" />
			<Add option="-D_WIN64" />
			<Add option="-DWXUSINGDLL" />
			<Add option="-DcbDEBUG" />
			<Add option="-DwxUSE_UNICODE" />
			<Add option="$(#CB_CPP_STD)" />
			<Add directory="$(#wx33_arm.include)" />
			<Add directory="$(#wx33_arm.lib)/clang_x64_dll_mono/msw$(WX_SUFFIX)" />
			<Add directory="../../../include" />
			<Add directory="../../../include/tinyxml" />
			<Add directory="../../../src" />
			<Add directory="../../../sdk/wxscintilla/include" />
		</Compiler>
		<Linker>
			<Add option="-mthreads" />
			<Add library="wxmsw$(WX_VERSION)$(WX_SUFFIX)" />
			<Add library="codeblocks" />
			<Add directory="../../../devel33_arm" />
			<Add directory="$(#wx33_arm.lib)/clang_x64_dll_mono" />
		</Linker>
		<ExtraCommands>
			<Add after="zip -j9 ..\..\..\devel33_arm\share\CodeBlocks\DragScroll.zip src\manifest.xml" />
			<Mode after="always" />
		</ExtraCommands>
		<Unit filename="src/dragscroll.cpp" />
		<Unit filename="src/dragscroll.h" />
		<Unit filename="src/dragscrollcfg.cpp" />
		<Unit filename="src/dragscrollcfg.h" />
		<Unit filename="src/dragscrollevent.cpp" />
		<Unit filename="src/dragscrollevent.h" />
		<Unit filename="src/linux_functions.cpp" />
		<Unit filename="src/linux_functions.h" />
		<Unit filename="src/manifest.xml" />
		<Extensions />
	</Project>
</CodeBlocks_project_file>
