<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Exporter wx3.3.x (ARM, 64 bit)" />
		<Option pch_mode="0" />
		<Option default_target="default" />
		<Option compiler="llvm-mingw-arm64_compiler" />
		<Build>
			<Target title="wxPdfDocument">
				<Option output="../../../devel33_arm/wxPdfDocument" prefix_auto="1" extension_auto="1" />
				<Option working_dir="" />
				<Option object_output="../../../.objs33_arm/plugins/contrib/source_exporter" />
				<Option type="2" />
				<Option compiler="llvm-mingw-arm64_compiler" />
				<Option projectCompilerOptionsRelation="2" />
				<Option projectLinkerOptionsRelation="2" />
				<Compiler>
					<Add option="$(#CB_RELEASE_TYPE)" />
					<Add option="$(#CB_CPP_STD)" />
					<Add option="-DWXMAKINGLIB_PDFDOC" />
					<Add option="-DZINT_NO_PNG" />
					<Add directory="wxPdfDocument/thirdparty/woff2/include" />
					<Add directory="wxPdfDocument/thirdparty/woff2/brotli/include" />
					<Add directory="wxPdfDocument/thirdparty/zint/backend" />
					<Add directory="wxPdfDocument/thirdparty/zint/backend/fonts" />
				</Compiler>
			</Target>
			<Target title="makefont">
				<Option output="../../../devel33_arm/wxPdfDocument/makefont" prefix_auto="0" extension_auto="1" />
				<Option working_dir="wxPdfDocument/makefont" />
				<Option object_output="../../../.objs33_arm/plugins/contrib/source_exporter" />
				<Option type="1" />
				<Option compiler="llvm-mingw-arm64_compiler" />
				<Compiler>
					<Add option="$(#CB_RELEASE_TYPE)" />
					<Add option="$(#CB_CPP_STD)" />
				</Compiler>
				<Linker>
					<Add library="wxPdfDocument" />
					<Add library="wxmsw$(WX_VERSION)$(WX_SUFFIX)" />
					<Add directory="../../../devel33_arm" />
				</Linker>
			</Target>
			<Target title="minimal">
				<Option output="../../../devel33_arm/wxPdfDocument/minimal" prefix_auto="0" extension_auto="1" />
				<Option working_dir="wxPdfDocument/samples/minimal" />
				<Option object_output="../../../.objs33_arm/plugins/contrib/source_exporter" />
				<Option type="1" />
				<Option compiler="llvm-mingw-arm64_compiler" />
				<Compiler>
					<Add option="$(#CB_RELEASE_TYPE)" />
					<Add option="$(#CB_CPP_STD)" />
				</Compiler>
				<Linker>
					<Add library="wxPdfDocument" />
					<Add library="wxmsw$(WX_VERSION)$(WX_SUFFIX)" />
					<Add directory="../../../devel33_arm" />
				</Linker>
			</Target>
			<Target title="pdfdc">
				<Option output="../../../devel33_arm/wxPdfDocument/pdfdc" prefix_auto="0" extension_auto="1" />
				<Option working_dir="wxPdfDocument/samples/pdfdc" />
				<Option object_output="../../../.objs33_arm/plugins/contrib/source_exporter" />
				<Option type="1" />
				<Option compiler="llvm-mingw-arm64_compiler" />
				<Compiler>
					<Add option="$(#CB_RELEASE_TYPE)" />
					<Add option="$(#CB_CPP_STD)" />
				</Compiler>
				<Linker>
					<Add library="wxPdfDocument" />
					<Add library="wxmsw$(WX_VERSION)$(WX_SUFFIX)" />
					<Add directory="../../../devel33_arm" />
				</Linker>
			</Target>
			<Target title="default">
				<Option output="../../../devel33_arm/share/CodeBlocks/plugins/Exporter" prefix_auto="0" extension_auto="1" />
				<Option object_output="../../../.objs33_arm/plugins/contrib/source_exporter" />
				<Option external_deps="../../../devel33_arm/libwxPdfDocument.a;" />
				<Option type="3" />
				<Option compiler="llvm-mingw-arm64_compiler" />
				<Option parameters="--debug-log --multiple-instance -na -ns -nd -p debug" />
				<Option host_application="../../../devel33_arm/codeblocks.exe" />
				<Option run_host_application_in_terminal="0" />
				<Option projectLinkerOptionsRelation="2" />
				<Compiler>
					<Add option="-DBUILDING_PLUGIN" />
					<Add option="-DNOPCH" />
					<Add option="-DcbDEBUG" />
					<Add option="$(#CB_RELEASE_TYPE)" />
					<Add option="$(#CB_CPP_STD)" />
					<Add directory="../../../include" />
					<Add directory="../../../include/tinyxml" />
					<Add directory="../../../sdk/wxscintilla/include" />
				</Compiler>
				<Linker>
					<Add library="codeblocks" />
					<Add library="wxPdfDocument" />
					<Add library="wxmsw$(WX_VERSION)$(WX_SUFFIX)" />
					<Add library="gdi32" />
					<Add directory="../../../devel33_arm" />
				</Linker>
				<ExtraCommands>
					<Add after="zip -j9 ..\..\..\devel33_arm\share\CodeBlocks\Exporter.zip manifest.xml" />
					<Mode after="always" />
				</ExtraCommands>
			</Target>
			<Environment>
				<Variable name="WX_CFG" value="" />
				<Variable name="WX_SUFFIX" value="u" />
				<Variable name="WX_VERSION" value="33" />
			</Environment>
		</Build>
		<VirtualTargets>
			<Add alias="All" targets="wxPdfDocument;default;" />
		</VirtualTargets>
		<Compiler>
			<Add option="-Wall" />
			<Add option="$(#CB_RELEASE_TYPE)" />
			<Add option="-fexceptions" />
			<Add option="-DHAVE_W32API_H" />
			<Add option="-D__WXMSW__" />
			<Add option="-D_WIN64" />
			<Add option="-DWXUSINGDLL" />
			<Add option="-DwxUSE_UNICODE" />
			<Add option="-DWXMAKINGDLL_PDFDOC" />
			<Add option="-DwxPDF_USE_WXMODULE=0" />
			<Add option="$(#CB_CPP_STD)" />
			<Add directory="$(#wx33_arm.include)" />
			<Add directory="$(#wx33_arm.lib)/clang_x64_dll_mono/msw$(WX_SUFFIX)" />
			<Add directory="wxPdfDocument/include" />
		</Compiler>
		<ResourceCompiler>
			<Add directory="$(#wx33_arm.include)" />
			<Add directory="wxPdfDocument/include" />
		</ResourceCompiler>
		<Linker>
			<Add option="-mthreads" />
			<Add directory="$(#wx33_arm.lib)/clang_x64_dll_mono" />
		</Linker>
