<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="CppCheck/Vera++ wx3.3.x (ARM, 64 bit)" />
		<Option pch_mode="0" />
		<Option compiler="llvm-mingw-arm64_compiler" />
		<Build>
			<Target title="cppcheck_app">
				<Option output="../../../devel33_arm/CppCheck" prefix_auto="1" extension_auto="1" />
				<Option object_output="../../../.objs33_arm/plugins/contrib/CppCheck" />
				<Option type="1" />
				<Option compiler="llvm-mingw-arm64_compiler" />
				<Option parameters="p.cpp --debug --enable=all" />
				<Compiler>
					<Add option="-Wshadow" />
					<Add option="-Wredundant-decls" />
					<Add option="-Wfloat-equal" />
					<Add option="-Winline" />
					<Add option="-Wmissing-declarations" />
					<Add option="-pedantic" />
					<Add option="-Wextra" />
					<Add option="-Wabi" />
					<Add option="-Wcast-qual" />
					<Add option="-Wmissing-format-attribute" />
					<Add option="-Wno-long-long" />
					<Add option="-Wpacked" />
					<Add option="-Wno-missing-field-initializers" />
					<Add option="-Wno-missing-braces" />
					<Add option="-Wno-sign-compare" />
					<Add option="-Wno-multichar" />
					<Add option="$(#CB_RELEASE_TYPE)" />
					<Add option="$(#CB_CPP_STD)" />
					<Add directory="cppcheck/externals/picojson" />
					<Add directory="cppcheck/externals/simplecpp" />
					<Add directory="cppcheck/externals/tinyxml2" />
					<Add directory="cppcheck/externals" />
					<Add directory="cppcheck/frontend" />
					<Add directory="cppcheck/lib" />
				</Compiler>
				<Linker>
					<Add library="shlwapi" />
				</Linker>
				<ExtraCommands>
					<Add after="cmd /c if not exist ..\..\..\devel33_arm\cfg mkdir ..\..\..\devel33_arm\cfg" />
					<Add after="cmd /c xcopy /D /Y cppcheck\cfg\*.* ..\..\..\devel33_arm\cfg" />
					<Add after="cmd /c if not exist ..\..\..\output33_arm\cfg mkdir ..\..\..\output33_arm\cfg" />
					<Add after="cmd /c xcopy /D /Y cppcheck\cfg\*.* ..\..\..\output33_arm\cfg" />
					<Mode after="always" />
				</ExtraCommands>
			</Target>
			<Target title="default">
				<Option output="../../../devel33_arm/share/codeblocks/plugins/CppCheck.dll" prefix_auto="0" extension_auto="0" />
				<Option object_output="../../../.objs33_arm/plugins/contrib/CppCheck" />
				<Option type="3" />
				<Option compiler="llvm-mingw-arm64_compiler" />
				<Option parameters="--debug-log --multiple-instance -na -ns -nd -p debug" />
				<Option host_application="../../../devel33_arm/codeblocks.exe" />
				<Option run_host_application_in_terminal="0" />
				<Compiler>
					<Add option="-fexceptions" />
					<Add option="-DBUILDING_PLUGIN" />
					<Add option="-DNOPCH" />
					<Add option="-DHAVE_W32API_H" />
					<Add option="-D__WXMSW__" />
					<Add option="-DWXUSINGDLL" />
					<Add option="-DcbDEBUG" />
					<Add option="-DwxUSE_UNICODE" />
					<Add option="$(#CB_RELEASE_TYPE)" />
					<Add option="$(#CB_CPP_STD)" />
					<Add directory="../../../include" />
					<Add directory="../../../include/tinyxml" />
					<Add directory="../../../sdk/wxscintilla/include" />
					<Add directory="$(#wx33_arm.INCLUDE)" />
					<Add directory="$(#wx33_arm.lib)/clang_x64_dll_mono/msw$(WX_SUFFIX)" />
				</Compiler>
				<ResourceCompiler>
					<Add directory="$(#wx33_arm.include)" />
				</ResourceCompiler>
				<Linker>
					<Add library="codeblocks" />
					<Add library="wxmsw$(WX_VERSION)$(WX_SUFFIX)" />
					<Add directory="../../../devel33_arm" />
					<Add directory="$(#wx33_arm.lib)/clang_x64_dll_mono" />
				</Linker>
				<ExtraCommands>
					<Add after="zip -j9 ../../../devel33_arm/share/codeblocks/CppCheck.zip resources/manifest.xml" />
					<Mode after="always" />
				</ExtraCommands>
				<Environment>
					<Variable name="WX_CFG" value="" />
					<Variable name="WX_SUFFIX" value="u" />
					<Variable name="WX_VERSION" value="33" />
				</Environment>
			</Target>
		</Build>
		<VirtualTargets>
			<Add alias="All" targets="cppcheck_app;default;" />
		</VirtualTargets>
		<Compiler>
			<Add option="-m64" />
			<Add option="-Wall" />
			<Add option="$(#CB_RELEASE_TYPE)" />
			<Add option="-D_WIN64" />
			<Add option="$(#CB_CPP_STD)" />
		</Compiler>
		<Linker>
			<Add option="-Wl,--enable-auto-import" />
			<Add option="-m64" />
			<Add option="-mthreads" />
		</Linker>
