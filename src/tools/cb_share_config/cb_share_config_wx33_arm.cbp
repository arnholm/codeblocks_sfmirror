<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Code::Blocks Share Config wx3.3.x (ARM, 64 bit)" />
		<Option pch_mode="2" />
		<Option compiler="llvm-mingw-arm64_compiler" />
		<Build>
			<Target title="default">
				<Option output="../../devel33_arm/cb_share_config" prefix_auto="0" extension_auto="1" />
				<Option working_dir="../../../devel33_arm" />
				<Option object_output="../../.objs33_arm/tools/cb_share_config" />
				<Option type="0" />
				<Option compiler="llvm-mingw-arm64_compiler" />
				<Compiler>
					<Add option="$(#CB_RELEASE_TYPE)" />
					<Add option="$(#CB_CPP_STD)" />
				</Compiler>
			</Target>
			<Environment>
				<Variable name="WX_CFG" value="" />
				<Variable name="WX_SUFFIX" value="u" />
				<Variable name="WX_VERSION" value="33" />
			</Environment>
		</Build>
		<VirtualTargets>
			<Add alias="All" targets="default;" />
		</VirtualTargets>
		<Compiler>
			<Add option="-pipe" />
			<Add option="-m64" />
			<Add option="-fmessage-length=0" />
			<Add option="-fexceptions" />
			<Add option="-DUSE_PCH" />
			<Add option="-D__GNUWIN32__" />
			<Add option="-D__WXMSW__" />
			<Add option="-DHAVE_W32API_H" />
			<Add option="-DwxUSE_UNICODE" />
			<Add option="-DWXUSINGDLL" />
			<Add option="-D_WIN64" />
			<Add option="$(#CB_RELEASE_TYPE)" />
			<Add option="$(#CB_CPP_STD)" />
			<Add directory="$(#wx33_arm.include)" />
			<Add directory="$(#wx33_arm.lib)/clang_x64_dll_mono/msw$(WX_SUFFIX)" />
			<Add directory="../../include" />
			<Add directory="../../include/tinyxml" />
		</Compiler>
		<ResourceCompiler>
			<Add directory="$(#wx33_arm.include)" />
		</ResourceCompiler>
		<Linker>
			<Add option="-mthreads" />
			<Add library="txml" />
			<Add library="wxmsw$(WX_VERSION)$(WX_SUFFIX)" />
			<Add directory="$(#wx33_arm.lib)/clang_x64_dll_mono" />
			<Add directory="../../devel33_arm" />
		</Linker>
		<Unit filename="app.cpp" />
		<Unit filename="app.h" />
		<Unit filename="mainframe.cpp" />
		<Unit filename="mainframe.h" />
		<Unit filename="wxsmith/MainFrame.wxs" />
		<Extensions>
			<wxsmith version="1">
				<gui name="wxWidgets" src="app.cpp" main="MainFrame" init_handlers="necessary" language="CPP" />
				<resources>
					<wxFrame wxs="wxsmith/MainFrame.wxs" src="mainframe.cpp" hdr="mainframe.h" fwddecl="0" i18n="1" name="MainFrame" language="CPP" />
				</resources>
			</wxsmith>
		</Extensions>
	</Project>
</CodeBlocks_project_file>
